using System;
using System.Collections.Generic;
using System.Reflection;
using System.Threading.Tasks;
using V3.WebhookSdk.Handlers;
using V3.WebhookSdk.Security;
using Domain.Notifications.V1;
using Domain.Events.V1;

namespace V3.WebhookSdk.Processing
{
    public class WebhookEventProcessor
    {
        private readonly Dictionary<(string group, string name), Delegate> _handlers;
        private readonly IWebhookSignatureValidator? _signatureValidator;

        public WebhookEventProcessor(
            Dictionary<(string group, string name), Delegate> handlers,
            IWebhookSignatureValidator? signatureValidator = null)
        {
            _handlers = handlers;
            _signatureValidator = signatureValidator;
        }

        public async Task ProcessWebhookAsync(string jsonPayload, string? signature = null)
        {
            if (string.IsNullOrWhiteSpace(jsonPayload))
                throw new InvalidOperationException("Webhook payload is empty");

            if (_signatureValidator is not null)
            {
                if (string.IsNullOrEmpty(signature))
                    throw new WebhookSignatureException("Missing webhook signature");

                _signatureValidator.Validate(jsonPayload, signature);
            }

            Webhook webhook;
            try
            {
                webhook = Webhook.Parser.ParseJson(jsonPayload);
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException(
                    "Failed to parse webhook JSON payload into protobuf",
                    ex
                );
            }

            await ProcessWebhookInternalAsync(webhook);
        }

        private async Task ProcessWebhookInternalAsync(Webhook webhook)
        {
            if (webhook.Attributes is null || webhook.Attributes.Count == 0)
                return;

            foreach (var evt in webhook.Attributes)
            {
                // Caso 1: eventos normais (trip/standalone)
                if (evt.Attributes?.Data is { } data)
                {
                    (string group, string name, object evtObj)? resolved = data switch
                    {
                        { TripEvent: { } trip } => ResolveTripEvent(trip),
                        { StandaloneEvent: { } standalone } => ResolveStandaloneEvent(standalone),
                        _ => null
                    };

                    if (resolved is not null)
                    {
                        var (group, name, eventObj) = resolved.Value;

                        if (_handlers.TryGetValue((group, name), out var handler))
                        {
                            var context = new EventContext
                            {
                                Id = evt.Id,
                                Status = evt.Status,
                                CreatedAt = evt.CreatedAt,
                                Type = evt.Type,
                                Category = evt.Category,
                                Sub = evt.Sub,
                                Device = evt.Attributes.Device,
                                Order = evt.Attributes.Order,
                                Location = ExtractLocationRecursive(eventObj)
                            };

                            var result = handler.DynamicInvoke(context, eventObj);

                            if (result is not Task task)
                                throw new InvalidOperationException(
                                    $"Handler for ({group}, {name}) must return a Task"
                                );

                            await task;
                            continue;
                        }
                    }
                }

                if (evt.Attributes?.Order is { } orderObj)
                {
                    var group = "ORDER";
                    string name = string.Empty;
                    var statusProp = orderObj.GetType().GetProperty("Status");
                    if (statusProp != null)
                    {
                        var statusValue = statusProp.GetValue(orderObj);
                        if (statusValue != null)
                        {
                            // Monta o nome do evento no padrão "ORDER_STATUS_" + sufixo do enum
                            name = $"ORDER_STATUS_{statusValue.ToString().ToUpper()}";
                        }
                    }
                    Console.WriteLine($"[PROCESSOR] Procurando handler para (group: '{group}', name: '{name}')");

                    if (_handlers.TryGetValue((group, name), out var handler))
                    {
                        Console.WriteLine($"[PROCESSOR] Handler encontrado para (group: '{group}', name: '{name}')");
                        var context = new EventContext
                        {
                            Id = evt.Id,
                            Status = evt.Status,
                            CreatedAt = evt.CreatedAt,
                            Type = evt.Type,
                            Category = evt.Category,
                            Sub = evt.Sub,
                            Device = evt.Attributes.Device,
                            Order = orderObj,
                            Location = ExtractLocationRecursive(orderObj)
                        };

                        var result = handler.DynamicInvoke(context, orderObj);

                        if (result is not Task task)
                            throw new InvalidOperationException(
                                $"Handler for ({group}, {name}) must return a Task"
                            );

                        await task;
                    }
                    else
                    {
                        Console.WriteLine($"[PROCESSOR] Handler NÃO encontrado para (group: '{group}', name: '{name}')");
                    }
                }
            }
        }

        private static (string group, string name, object evt)? ResolveTripEvent(object trip)
        {
            foreach (var extractor in TripEventExtractors.Values)
            {
                var (name, evt) = extractor(trip);
                if (evt is null)
                    continue;

                return (
                    Normalize(GetProperty(trip, "EventGroupName") as string),
                    Normalize(name ?? evt.GetType().Name),
                    evt
                );
            }

            return null;
        }

        private static (string group, string name, object evt)? ResolveStandaloneEvent(object standalone)
        {
            foreach (var extractor in StandaloneEventExtractors.Values)
            {
                var (name, evt) = extractor(standalone);
                if (evt is null)
                    continue;

                return (
                    Normalize(GetProperty(standalone, "EventGroupName") as string),
                    Normalize(name ?? evt.GetType().Name),
                    evt
                );
            }

            return null;
        }

        private static string Normalize(string? value) =>
            string.IsNullOrWhiteSpace(value)
                ? string.Empty
                : value.Trim();

        private static Domain.Location.V1.Location? ExtractLocationRecursive(object eventObj)
        {
            var type = eventObj.GetType();

            if (type.GetProperty("Location")?.GetValue(eventObj) is Domain.Location.V1.Location direct)
                return direct;

            foreach (var prop in type.GetProperties(BindingFlags.Public | BindingFlags.Instance))
            {
                if (prop.PropertyType.IsPrimitive || prop.PropertyType == typeof(string))
                    continue;

                if (prop.GetValue(eventObj) is not object value)
                    continue;

                var loc = ExtractLocationRecursive(value);
                if (loc is not null)
                    return loc;
            }

            return null;
        }

        private static readonly IReadOnlyDictionary<string, Func<object, (string? Name, object? Event)>> TripEventExtractors =
            new Dictionary<string, Func<object, (string?, object?)>>
            {
                { "Dms", t => (GetEventName(t, "Dms"), GetProperty(t, "Dms")) },
                { "DriverBehavior", t => (GetEventName(t, "DriverBehavior"), GetProperty(t, "DriverBehavior")) },
                { "Telemetry", t => (GetEventName(t, "Telemetry"), GetProperty(t, "Telemetry")) },
                { "Vehicle", t => (GetEventName(t, "Vehicle"), GetProperty(t, "Vehicle")) },
                { "Vision", t => (GetEventName(t, "Vision"), GetProperty(t, "Vision")) },
                { "Adas", t => (GetEventName(t, "Adas"), GetProperty(t, "Adas")) },
            };

        private static readonly IReadOnlyDictionary<string, Func<object, (string? Name, object? Event)>> StandaloneEventExtractors =
            new Dictionary<string, Func<object, (string?, object?)>>
            {
                { "Alert", s => (GetEventName(s, "Alert"), GetProperty(s, "Alert")) },
                { "Connection", s => (GetEventName(s, "Connection"), GetProperty(s, "Connection")) },
                { "Health", s => (GetEventName(s, "Health"), GetProperty(s, "Health")) },
                { "Telemetry", s => (GetEventName(s, "Telemetry"), GetProperty(s, "Telemetry")) },
                { "System", s => (GetEventName(s, "System"), GetProperty(s, "System")) },
            };

        private static object? GetProperty(object obj, string name) =>
            obj.GetType().GetProperty(name)?.GetValue(obj);

        private static string? GetEventName(object obj, string propName)
        {
            if (GetProperty(obj, propName) is not object prop)
                return null;

            return prop.GetType()
                       .GetProperty("EventName")
                       ?.GetValue(prop) as string;
        }
    }
}
